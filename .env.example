# =====================================================================================
# LeoMox environment. Copy to .env for development; set the same names in Render's dashboard.
# Defaults below are the SAFE DEVELOPMENT set: every provider is a mock, recordings go to local disk.
# The PRODUCTION block at the bottom lists what to change for a real deployment.
# NEVER put secrets in VITE_* variables: they are bundled into the public frontend (the server refuses to start if you do).
# =====================================================================================
NODE_ENV=development
PORT=10000

# Your app's own public HTTPS URL (e.g. https://your-app.onrender.com). Needed for telephony callbacks.
PUBLIC_BASE_URL=
# Your frontend origin. Leave empty in development; set it in production (CORS).
CORS_ORIGIN=

# --- Database (Neon pooled connection string) ---
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/leomox?sslmode=require
PG_POOL_MAX=10
PG_STATEMENT_TIMEOUT_MS=30000

# --- Auth ---
# At least 32 random characters in production:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-of-32-or-more-characters
JWT_EXPIRES_IN=8h

# --- AI provider (LLM). mock | gemini ---
AI_PROVIDER=mock
AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Embeddings (knowledge base / pgvector). mock | google ---
EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001

# --- Speech. Only "mock" has a standalone adapter today (Sarvam STT/TTS adapters are NOT shipped yet).
#     On phone calls, speech is handled by the telephony provider (Twilio <Gather>/<Say>). ---
STT_PROVIDER=mock
STT_API_KEY=
TTS_PROVIDER=mock
TTS_API_KEY=

# --- Telephony. mock | twilio (the provider layer is pluggable: implement TelephonyProvider to add another vendor) ---
TELEPHONY_PROVIDER=mock
TELEPHONY_API_KEY=
TELEPHONY_API_SECRET=
TELEPHONY_PHONE_NUMBER=
# For non-Twilio providers, and for mock in production: webhooks must be signed with HMAC-SHA256 over "<timestamp>.<json body>"
# (headers X-Webhook-Timestamp, X-Webhook-Signature; 5-minute replay window).
TELEPHONY_WEBHOOK_SECRET=

# --- Business Integrations (credentials are encrypted at rest and never returned by the API) ---
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Outbound integration calls are SSRF-protected: public hosts only, https only in production, port 443 only.
# SSRF_ALLOWED_PORTS=8443,9443
# SSRF_ALLOW_HTTP=false

# --- Call recordings: private object storage ---
# local = server disk (development ONLY). The server REFUSES to start in production with local storage.
# s3    = any S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2, MinIO). Keep the bucket PRIVATE.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads/recordings
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com   (AWS S3: leave empty)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
RECORDING_MAX_MB=50
# Default retention for agents without their own setting (days). Empty = keep forever.
RECORDING_RETENTION_DAYS=
# Hosts the telephony provider serves recordings from, comma-separated (Twilio: api.twilio.com)
RECORDING_URL_ALLOWLIST=

# --- Safety limits (defaults shown; every rate limit is per user or per IP) ---
MAX_CSV_ROWS=5000
# RL_API_MAX=300  RL_LOGIN_IP_MAX=20  RL_LOGIN_ACCOUNT_MAX=8  RL_PASSWORD_MAX=10  RL_CALL_MAX=30  RL_CAMPAIGN_LAUNCH_MAX=10
# RL_INTEGRATION_TEST_MAX=20  RL_UPLOAD_MAX=30  RL_RECORDING_UPLOAD_MAX=30  RL_IMPORT_MAX=10  RL_CONTACT_FORM_MAX=5  RL_AI_MAX=40  RL_WEBHOOK_MAX=600
# Never set in production:
# RATE_LIMIT_DISABLED=true
# Live Calls socket: the token is sent in the Sec-WebSocket-Protocol header. Set false to refuse the ?token= fallback.
# WS_ALLOW_QUERY_TOKEN=false
# Dialer: true (default) = only one instance ticks at a time (recommended).
# DIALER_ADVISORY_LOCK=true

# --- Frontend (only used by `vite dev`) ---
VITE_API_URL=

# --- Tests only (npm run test:security): a throw-away Postgres with the pgvector extension. Empty = in-process PGlite. ---
# TEST_DATABASE_URL=postgresql://user:pass@localhost:5432/leomox_test

# =====================================================================================
# PRODUCTION (Render dashboard). Gemini + Cloudflare R2 + Neon, telephony still mock until you connect a vendor:
#   NODE_ENV=production
#   DATABASE_URL=...  JWT_SECRET=<32+ random chars>  ENCRYPTION_KEY=<32 bytes base64>  CORS_ORIGIN=https://your-app.onrender.com
#   PUBLIC_BASE_URL=https://your-app.onrender.com
#   AI_PROVIDER=gemini            AI_API_KEY=...
#   EMBEDDING_PROVIDER=google     EMBEDDING_API_KEY=...        (changing the embedding model requires re-indexing documents)
#   STT_PROVIDER=mock  TTS_PROVIDER=mock                        (Sarvam: adapter not shipped; see README "Providers")
#   TELEPHONY_PROVIDER=mock       TELEPHONY_WEBHOOK_SECRET=...  (or twilio + its keys)
#   STORAGE_PROVIDER=s3  S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com  S3_REGION=auto
#   S3_BUCKET=...  S3_ACCESS_KEY_ID=...  S3_SECRET_ACCESS_KEY=...
#   Render Pre-Deploy Command:  npm run db:migrate        (never run db:seed in production)
# =====================================================================================
